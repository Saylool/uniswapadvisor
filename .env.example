# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
#
# Every credential here is server-side only. Do not prefix any of these with
# NEXT_PUBLIC_ — that would inline the secret into the client bundle.

# OpenAI API key, used server-side for strategy analysis.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# The Graph API key, used server-side to query the Uniswap v3/v4 subgraphs.
# Sent only as an Authorization header, never in a URL or request body.
# https://thegraph.com/studio/apikeys/
THE_GRAPH_API_KEY=

# Stable Subgraph ID of the Uniswap v3 Ethereum mainnet subgraph, as shown in The
# Graph Explorer. This is NOT a deployment/IPFS id: the gateway's
# /api/subgraphs/id/ endpoint resolves a Subgraph ID to whichever deployment
# indexers report as sufficiently synced, so queries follow published upgrades
# instead of pinning to one frozen version.
# Server-side only: it selects which subgraph the server queries and is never
# read by the browser.
UNISWAP_V3_ETHEREUM_SUBGRAPH_ID=
